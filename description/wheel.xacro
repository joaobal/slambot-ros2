<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="drive_wheel" params="side parent:=base_link y_offset">
        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="${parent}"/>
            <child link="${side}_wheel"/>
            <origin xyz="0 ${y_offset} 0" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
        <link name="${side}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.035" length="0.0249"/>
                </geometry>
                <material name="black"/>
            </visual>
        </link>
        <joint name="${side}_tire_joint" type="fixed">
            <parent link="${side}_wheel"/>
            <child link="${side}_tire"/>
        </joint>
        <link name="${side}_tire">
            <visual>
                <geometry>
                    <cylinder radius="0.025" length="0.0250"/>
                </geometry>
                <material name="yellow"/>
            </visual>
        </link>
    </xacro:macro>
</robot>
